APP_NAME=Influencer Outreach AI
APP_ENV=development
DEBUG=true

MONGODB_USERNAME="your_mongodb_username"
MONGODB_PASSWORD="your_mongodb_password"
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DATABASE=influencer_outreach

FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=your_gmail_address@gmail.com
SMTP_USE_TLS=true

EMAIL_MODE=simulation
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_MS=30000
SCRAPER_DELAY_MIN_MS=1000
SCRAPER_DELAY_MAX_MS=2500
SCRAPER_MAX_CANDIDATES=150
SCRAPER_MAX_QUERIES=10
SCRAPER_MAX_RESULTS_PER_QUERY=15